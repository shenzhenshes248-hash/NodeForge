#!/usr/bin/env bash
# Generated by tools/build_bootstrap.py; edit the template/shared verifier instead.
set -Eeuo pipefail
set +x
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

bootstrap_main() {
    [[ $(id -u) == 0 ]] || { printf 'Run bootstrap as root\n' >&2; return 1; }
    if [[ $(uname -m) != x86_64 ]] || ! grep -qx 'ID=debian' /etc/os-release ||
        ! grep -qx 'VERSION_ID="12"' /etc/os-release; then
        printf 'Bootstrap requires Debian 12 amd64\n' >&2; return 1
    fi
    if ! command -v curl >/dev/null || ! command -v python3 >/dev/null ||
        ! command -v openssl >/dev/null || [[ ! -s /etc/ssl/certs/ca-certificates.crt ]]; then
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl python3 openssl
    fi
    NF_BOOT_TMP=$(mktemp -d /tmp/nodeforge-bootstrap-XXXXXXXX)
    trap 'rm -rf -- "$NF_BOOT_TMP"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    mkdir "$NF_BOOT_TMP/tools" "$NF_BOOT_TMP/trust"
    cat > "$NF_BOOT_TMP/trust/release-ed25519.pub" <<'NODEFORGE_PUBLIC_KEY'
@@PUBLIC_KEY@@
NODEFORGE_PUBLIC_KEY
    cat > "$NF_BOOT_TMP/tools/release.py" <<'NODEFORGE_VERIFIER'
@@VERIFIER@@
NODEFORGE_VERIFIER
    local version='@@VERSION@@' asset base source file
    base="https://github.com/shenzhenshes248-hash/NodeForge/releases/download/$version"
    for asset in manifest.json manifest.sig "nodeforge-$version.tar.gz"; do
        curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
            --connect-timeout 15 --max-time 300 --output "$NF_BOOT_TMP/$asset" "$base/$asset"
    done
    python3 "$NF_BOOT_TMP/tools/release.py" extract \
        --artifact "$NF_BOOT_TMP/nodeforge-$version.tar.gz" \
        --manifest "$NF_BOOT_TMP/manifest.json" --signature "$NF_BOOT_TMP/manifest.sig" \
        --destination "$NF_BOOT_TMP/extracted"
    source="$NF_BOOT_TMP/extracted/nodeforge-$version"
    for file in @@FILES@@; do
        [[ -f $source/$file && ! -L $source/$file ]] || {
            printf 'Incomplete release bundle\n' >&2; return 1;
        }
    done
    bash "$source/install.sh" "$@" </dev/null
}

bootstrap_main "$@"
