[Unit]
Description=NodeForge Argo Xray (VLESS loopback)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=nodeforge
Group=nodeforge
ExecStart=/usr/local/nodeforge/argo/xray run -config /usr/local/nodeforge/argo/xray.json
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
